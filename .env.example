##Development Environment Variables
#https://dev.emportal.me/#/
# This file contains environment variables for the development environment.
# NODE_ENV=development
# BASE_URL=https://dev.emportal.me/
# USER=your.email@example.com
# PASSWORD=your_password_here
##Production Environment Variables
# https://edvenswatech.emportal.me/
# This file contains environment variables for the production environment.
NODE_ENV=production
BASE_URL=https://edvenswatech.emportal.me/
USER=your.email@example.com
PASSWORD=your_password_here

# Timesheet: set to true to permanently submit; default is save-as-draft only.
SUBMIT_TIMESHEET=false

# Company holiday override (YYYY-MM-DD). Defaults to the 14th of the current month.
# HOLIDAY_DATE=YYYY-MM-DD

# ── Paid Leave Configuration ───────────────────────────────────────────────────
# Enable to add a Paid Leave task for the given date in the current week's
# timesheet. Regular task hours are automatically reduced so the combined total
# equals TIMESHEET_WEEKLY_TARGET_HOURS (paid leave + actual work = 40h).
TIMESHEET_INCLUDE_PAID_LEAVE=false
# Date of the paid leave day (YYYY-MM-DD). Must be a Mon-Fri of the current week.
TIMESHEET_PAID_LEAVE_DATE=YYYY-MM-DD
# Hours of paid leave on that date (1-8, whole number). Full-day leave = 8.
# Rule enforced: (5 - skippedDays) × 8h + leaveHours = TIMESHEET_WEEKLY_TARGET_HOURS
TIMESHEET_PAID_LEAVE_HOURS=8
# Expected total working hours for the week (default: 40).
TIMESHEET_WEEKLY_TARGET_HOURS=40
# ──────────────────────────────────────────────────────────────────────────────

RATING_START_DATE=16/06/2026
RATING_END_DATE=30/06/2026
SUBMIT_RATING=false
# Note: Copy this file to .env, fill in your credentials, and set TIMESHEET_INCLUDE_PAID_LEAVE=true
# with a valid TIMESHEET_PAID_LEAVE_DATE when you need to record paid leave for the week.